  "views": [
    {
      "name": "current_dept_emp",
      "status": "source-definition-only",
      "columns": [
        "emp_no",
        "dept_no",
        "from_date",
        "to_date"
      ],
      "sourceSql": "CREATE VIEW current_dept_emp AS\n              SELECT l.emp_no, d.dept_no, l.from_date, l.to_date\n              FROM dept_emp AS d\n              INNER JOIN dept_emp_latest_date AS l\n                ON d.emp_no = l.emp_no AND d.from_date = l.from_date AND l.to_date = d.to_date"
    },
    {
      "name": "dept_emp_latest_date",
      "status": "source-definition-only",
      "columns": [
        "emp_no",
        "from_date",
        "to_date"
      ],
      "sourceSql": "CREATE VIEW dept_emp_latest_date AS\n              SELECT emp_no, MAX(from_date) AS from_date, MAX(to_date) AS to_date\n              FROM dept_emp GROUP BY emp_no"
    }
  ],
